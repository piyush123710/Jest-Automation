# Environment Configuration for Salon API Jest Automation Suite
# Copy this file to .env and fill in your values

# ─── Mode ────────────────────────────────────────────────────────────────────
# Set USE_MOCK=true to run tests against the high-fidelity in-memory mock engine
# Set USE_MOCK=false to run tests against the live Salon Backend API
USE_MOCK=true

# ─── Base URL ────────────────────────────────────────────────────────────────
# The base URL of the running Salon Backend API (when USE_MOCK=false)
BASE_URL=http://localhost:3000

# ─── JWT Secret ──────────────────────────────────────────────────────────────
# Must match the JWT_SECRET used by the Salon Backend
JWT_SECRET=your_jwt_secret_here

# ─── Test Seed Data IDs ───────────────────────────────────────────────────────
# MongoDB ObjectId of an existing Salon document in the database
TEST_SALON_ID=000000000000000000000001

# MongoDB ObjectId of a Stylist (User with role=stylist) in the database
TEST_STYLIST_ID=000000000000000000000002

# MongoDB ObjectId of a Service document in the database
TEST_SERVICE_ID=000000000000000000000003
