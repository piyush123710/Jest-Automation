# Environment Configuration for Salon API Jest Automation Suite
# Copy this file to .env and fill in your values

# ─── Base URL ────────────────────────────────────────────────────────────────
# The base URL of the running Salon Backend API
BASE_URL=http://localhost:3000

# ─── JWT Secret ──────────────────────────────────────────────────────────────
# Must match the JWT_SECRET used by the Salon Backend
JWT_SECRET=your_jwt_secret_here

# ─── Test Seed Data IDs ───────────────────────────────────────────────────────
# MongoDB ObjectId of an existing Salon document in the database
# (required for slot-availability and booking tests)
TEST_SALON_ID=<paste_salon_objectid_here>

# MongoDB ObjectId of a Stylist (User with role=stylist) in the database
TEST_STYLIST_ID=<paste_stylist_objectid_here>

# MongoDB ObjectId of a Service document in the database
TEST_SERVICE_ID=<paste_service_objectid_here>
