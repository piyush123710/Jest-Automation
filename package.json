{
  "name": "salon-api-jest-automation",
  "version": "1.0.0",
  "description": "Pure JavaScript & Node.js Jest API automation suite for Salon Booking Backend",
  "main": "index.js",
  "scripts": {
    "test": "jest --runInBand --detectOpenHandles",
    "test:verbose": "jest --runInBand --detectOpenHandles --verbose",
    "test:coverage": "jest --runInBand --detectOpenHandles --coverage",
    "test:auth": "jest --runInBand --detectOpenHandles --testPathPattern=auth",
    "test:booking": "jest --runInBand --detectOpenHandles --testPathPattern=booking",
    "test:e2e": "jest --runInBand --detectOpenHandles --testPathPattern=e2e",
    "test:salon": "jest --runInBand --detectOpenHandles --testPathPattern=salon"
  },
  "keywords": [
    "jest",
    "javascript",
    "nodejs",
    "api",
    "automation",
    "testing",
    "salon"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "tests/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}
